<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <AssemblyName>Cue.Generator.Tests</AssemblyName>
    <RootNamespace>Cue.Generator.Tests</RootNamespace>
    <UseTestingPlatform>true</UseTestingPlatform>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="Microsoft.Testing.Platform" Version="2.0.2" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="YTest.MTP.XUnit2" Version="1.0.3" />
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cue.Api\Cue.Api.csproj" />
    <ProjectReference Include="..\Cue.Generator\Cue.Generator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\libcue.so" Condition="'$(OS)' != 'Windows_NT'">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="..\cue.dll" Condition="'$(OS)' == 'Windows_NT'">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>

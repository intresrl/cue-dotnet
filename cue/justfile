# justfile - Build commands for CUE API specification
# Install: https://github.com/casey/just
# Run: just <recipe> or just <recipe> <domain>

set shell := ["bash", "-c"]

default:
    @just --list

gen-openapi:
    cue def ./api/... --out openapi > dist/schema.json
    cue def ./paths/... --out json > dist/paths.json
    rm -f dist/openapi.json
    cue export json: dist/paths.json json: dist/schema.json -o dist/openapi.json

# Serve API docs (requires Python)
serve-docs:
    @echo "Starting API docs server..."
    @echo "Visit: http://localhost:8000"
    @echo "Press Ctrl+C to stop"
    @cd dist && python3 -m http.server 8000

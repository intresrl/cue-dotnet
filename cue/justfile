# justfile - Build commands for CUE API specification
# Install: https://github.com/casey/just
# Run: just <recipe> or just <recipe> <domain>

set shell := ["bash", "-c"]

default:
    @just --list

# ============================================================================
# FRAMEWORK EVALUATION
# ============================================================================

# Evaluate framework (base types and CRUD template)
eval-framework:
    cue eval framework/primitives.cue framework/crud.cue

# Type definitions only
def-framework:
    cue def framework/primitives.cue framework/crud.cue

# ============================================================================
# PARAMETERIZED RESOURCE EVALUATION
# ============================================================================

# Evaluate specific resource domain: just eval documents|users|teams
eval domain="documents":
    @case "{{ domain }}" in \
      documents) cue eval framework/primitives.cue framework/crud.cue resources/documents/types.cue resources/documents/endpoints.cue ;; \
      users) cue eval framework/primitives.cue framework/crud.cue resources/users/types.cue resources/users/endpoints.cue ;; \
      teams) cue eval framework/primitives.cue framework/crud.cue resources/teams/types.cue resources/teams/endpoints.cue ;; \
      *) echo "Usage: just eval <domain> where domain is documents|users|teams" ;; \
    esac

# Evaluate all resources
eval-all:
    cue eval framework/primitives.cue framework/crud.cue resources/*/types.cue resources/*/endpoints.cue

# ============================================================================
# API ASSEMBLY
# ============================================================================

# Evaluate complete API
eval-api:
    cd operations && cue eval ./api.cue

# Export API to JSON
export-json:
    cd operations && cue export ./api.cue -e APISpec --out json 2>/dev/null | head -500 || echo "Note: Some fields may be incomplete in the schema"

# ============================================================================
# OPENAPI 3.0 GENERATION
# ============================================================================

# Generate OpenAPI 3.0 JSON spec
gen-openapi:
    @mkdir -p dist
    @python3 scripts/gen_openapi.py > dist/openapi.json 2>/dev/null && echo "✓ Generated dist/openapi.json" || echo "Error: Could not generate OpenAPI spec"

# Generate OpenAPI and copy HTML
gen-docs: gen-openapi
    @cp swagger.html dist/index.html
    @echo "✓ Generated dist/index.html"
    @echo ""
    @echo "View API docs:"
    @echo "  Open dist/index.html in a browser"
    @echo "  Or run: just serve-docs"

# Serve API docs (requires Python)
serve-docs: gen-docs
    @echo "Starting API docs server..."
    @echo "Visit: http://localhost:8000"
    @echo "Press Ctrl+C to stop"
    @cd dist && python3 -m http.server 8000

# ============================================================================
# TESTING
# ============================================================================

# Test create operation: just test <domain> [operation]
test domain="documents" op="create":
    @case "{{ op }}" in \
      create) cue eval framework/primitives.cue framework/crud.cue resources/{{ domain }}/types.cue resources/{{ domain }}/endpoints.cue -e Endpoints.Create ;; \
      read) cue eval framework/primitives.cue framework/crud.cue resources/{{ domain }}/types.cue resources/{{ domain }}/endpoints.cue -e Endpoints.Read ;; \
      list) cue eval framework/primitives.cue framework/crud.cue resources/{{ domain }}/types.cue resources/{{ domain }}/endpoints.cue -e Endpoints.List ;; \
      update) cue eval framework/primitives.cue framework/crud.cue resources/{{ domain }}/types.cue resources/{{ domain }}/endpoints.cue -e Endpoints.Update ;; \
      delete) cue eval framework/primitives.cue framework/crud.cue resources/{{ domain }}/types.cue resources/{{ domain }}/endpoints.cue -e Endpoints.Delete ;; \
      *) echo "Usage: just test <domain> <op> where op is create|read|list|update|delete" ;; \
    esac

# ============================================================================
# VALIDATION & METRICS
# ============================================================================

# Validate syntax
validate:
    @echo "Validating..."
    @cue eval framework/... && echo "✓ Framework"
    @cue eval resources/... && echo "✓ Resources"
    @cd operations && cue eval ./api.cue && echo "✓ Operations"

# Count lines
count-lines:
    @echo "Framework:"; wc -l framework/*.cue | tail -1
    @echo "Resources:"; wc -l resources/*/*.cue | tail -1
    @echo "Operations:"; wc -l operations/*.cue | tail -1

# Show file structure
structure:
    @find . -name "*.cue" -type f | sort

# ============================================================================
# DOCUMENTATION
# ============================================================================

# Show compilation order
compile-order:
    @echo "1. framework/primitives.cue  (base types)"
    @echo "2. framework/crud.cue        (CRUD template)"
    @echo "3. resources/*/types.cue     (domain types)"
    @echo "4. resources/*/endpoints.cue (specializations)"
    @echo "5. operations/*.cue          (assembly)"

# Help for adding new resource
help-add-resource:
    @echo "Add new resource in 3 steps:"
    @echo ""
    @echo "1. mkdir -p resources/PROJECT"
    @echo ""
    @echo "2. Create resources/PROJECT/types.cue:"
    @echo "   package PROJECT"
    @echo "   import fw \"example.com/apispec/framework\""
    @echo "   DomainEnum: \"value1\" | \"value2\""
    @echo "   Resource: { id?: string }"
    @echo "   ListItem: { id: string }"
    @echo "   Filter: {} & fw.PaginationRequest"
    @echo ""
    @echo "3. Create resources/PROJECT/endpoints.cue:"
    @echo "   package PROJECT"
    @echo "   import fw \"example.com/apispec/framework\""
    @echo "   Endpoints: {"
    @echo "     Create: fw.CRUDTemplate.Create & { request: Resource }"
    @echo "     Read: fw.CRUDTemplate.Read & { response: \"200\": Resource }"
    @echo "     List: fw.CRUDTemplate.List & { request: filter?: Filter }"
    @echo "     Update: fw.CRUDTemplate.Update & { response: \"200\": Resource }"
    @echo "     Delete: fw.CRUDTemplate.Delete"
    @echo "     BatchCreate: fw.CRUDTemplate.BatchCreate & { request: items: [...Resource] }"
    @echo "     BatchUpdate: fw.CRUDTemplate.BatchUpdate & { request: { filter: Filter, updates: Resource } }"
    @echo "     BatchDelete: fw.CRUDTemplate.BatchDelete & { request: filter: Filter }"
    @echo "   }"
    @echo ""
    @echo "4. Update operations/api.cue:"
    @echo "   Add import and endpoints"

# Show what's available
summary:
    @echo "CUE API Specification - Modular Architecture"
    @echo ""
    @echo "Evaluation:"
    @echo "  just eval documents     # Evaluate documents domain"
    @echo "  just eval users         # Evaluate users domain"
    @echo "  just eval teams         # Evaluate teams domain"
    @echo "  just eval-all           # All domains"
    @echo "  just eval-api           # Complete API"
    @echo ""
    @echo "OpenAPI & Documentation:"
    @echo "  just gen-openapi        # Generate openapi.json"
    @echo "  just gen-docs           # Generate API docs (dist/index.html)"
    @echo "  just serve-docs         # Serve on http://localhost:8000"
    @echo ""
    @echo "Testing & Validation:"
    @echo "  just test documents     # Test documents create"
    @echo "  just test users list    # Test users list"
    @echo "  just validate           # Validate all files"
    @echo ""
    @echo "Reference:"
    @echo "  just compile-order      # Show build order"
    @echo "  just help-add-resource  # Add new resource"
